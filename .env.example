# Copiar a .env y ajustar. docker-compose lee estas variables automaticamente.
# .env esta gitignoreado; este .env.example si se versiona como plantilla.

# Credenciales de la base de datos (compartidas por el contenedor de Postgres y la app).
DB_USERNAME=root
DB_PASSWORD=rootpassword
DB_NAME=cafeteria_db

# Perfil Spring con el que arranca la app en el contenedor.
SPRING_PROFILES_ACTIVE=prod

# OBLIGATORIA: secreto para firmar los JWT (usar una cadena larga y aleatoria en produccion).
JWT_SECRET=change-me-to-a-long-random-secret-string-at-least-32-chars
JWT_EXPIRATION_MINUTES=60
