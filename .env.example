# Copiar a .env y ajustar. docker-compose lee estas variables automaticamente.
# .env esta gitignoreado; este .env.example si se versiona como plantilla.

# Credenciales de la base de datos (compartidas por el contenedor de Postgres y la app).
DB_USERNAME=root
DB_PASSWORD=rootpassword
DB_NAME=cafeteria_db

# Perfil Spring con el que arranca la app en el contenedor.
SPRING_PROFILES_ACTIVE=prod

# OBLIGATORIA: secreto para firmar los JWT (usar una cadena larga y aleatoria en produccion).
# Generar con: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-string-at-least-32-chars
JWT_EXPIRATION_MINUTES=60

# Arranque en frio: con el perfil prod la base recien migrada queda sin ningun usuario y nadie
# puede hacer login. Poner APP_SEED_ENABLED=true SOLO para el primer arranque; despues de entrar
# y cambiar la clave, volver a false y reiniciar. El seeder es idempotente y no pisa la clave
# cambiada, pero dejar credenciales de arranque vivas en produccion no tiene sentido.
APP_SEED_ENABLED=false
APP_SEED_EMPLOYEE_EMAIL=
APP_SEED_EMPLOYEE_PASSWORD=
